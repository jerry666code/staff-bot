# Токен бота из Discord Developer Portal → Bot → Reset Token.
DISCORD_BOT_TOKEN=

# ID сервера (ПКМ по серверу → Copy Server ID, нужен Developer Mode).
GUILD_ID=

# Роль, которой разрешено подавать заявки /uw, /gw, /vac.
STAFF_ROLE_ID=

# Роль, которой разрешено нажимать "Выполнить"/"Отклонить" под заявкой.
# Если не задать — используется та же роль, что и STAFF_ROLE_ID.
APPROVER_ROLE_ID=
